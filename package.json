{
  "name": "airvue-root",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "vercel-build": "npm --prefix client install --include=dev && npm --prefix client run build",
    "build": "npm --prefix client install --include=dev && npm --prefix client run build",
    "install:all": "npm install",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "start": "node server/server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
